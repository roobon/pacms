                    "link": {
                      "type": "url",
                      "url": "/get-involved"
                    },
                    "variant": "outline"
                  },
                  "style": {
                    "typography": {
                      "transform": "uppercase",
                      "weight": 700,
                      "size": {
                        "$token": "font-size.sm"
                      },
                      "letter_spacing": "wider"
                    }
                  }
                }
              ]
            }
          ]
        }
      ],
      "content": {
        "aria_label": "Site header"
      },
      "style": {
        "background": {
          "type": "color",
          "color": {
            "$token": "color.primary"
