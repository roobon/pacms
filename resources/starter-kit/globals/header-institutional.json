{
  "schema_version": "1.0",
  "kind": "block",
  "meta": {
    "generator": "PACMS starter kit",
    "title": "Header: Institutional"
  },
  "blocks": [
    {
      "type": "section",
      "layout": {
        "container": "boxed",
        "padding": {
          "top": {
            "$token": "space.5"
          },
          "bottom": {
            "$token": "space.5"
          }
        }
      },
      "children": [
        {
          "type": "columns",
          "layout": {
            "columns": {
              "desktop": [
                3,
                9
              ],
              "mobile": [
                6,
                6
              ]
            },
            "gap": {
              "$token": "space.4"
            }
          },
          "children": [
            {
              "type": "column",
              "children": [
                {
                  "type": "site-logo",
                  "content": {
