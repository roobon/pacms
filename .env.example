# ---------------------------------------------------------------------------
# Probha Aurora CMS (PACMS) — environment template
# Copy to .env and fill in values. NEVER commit .env or ship it in a release ZIP.
# ---------------------------------------------------------------------------

APP_NAME="Probha Aurora CMS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.org

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pacms
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

# Domains whose browser requests use Sanctum cookie authentication (the site's own domain)
SANCTUM_STATEFUL_DOMAINS=example.org

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# file | database | redis (optional)
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Real SMTP is required in production (email verification, password reset)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@example.org"
MAIL_FROM_NAME="${APP_NAME}"

# --- PACMS ------------------------------------------------------------------
# Require two-factor authentication for privileged admin roles (keep true in production)
PACMS_ENFORCE_2FA=true
# Allow public self-registration of "Registered User" accounts (testimonial submission)
PACMS_PUBLIC_REGISTRATION=true
# true = a persistent queue worker (Supervisor/systemd) is running; false = the scheduler runs a short-lived worker every minute
PACMS_MANAGED_QUEUE_WORKER=false

VITE_APP_NAME="${APP_NAME}"
