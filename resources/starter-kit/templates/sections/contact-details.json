                },
                {
                  "type": "list",
                  "content": {
                    "style": "icon",
                    "dividers": true,
                    "item_padding": "sm",
                    "items": [
                      {
                        "icon": "bi-envelope",
                        "text": "info@example.org",
                        "link": {
                          "type": "url",
                          "url": "mailto:info@example.org"
                        }
                      },
                      {
                        "icon": "bi-telephone",
                        "text": "+880 1700 000000",
                        "link": {
                          "type": "url",
                          "url": "tel:+8801700000000"
                        }
                      },
                      {
                        "icon": "bi-geo-alt",
                        "text": "House 1, Road 1, Dhaka 1200, Bangladesh"
                      }
                    ]
                  }
                }
              ]
            },
            {
              "type": "column",
              "children": [
                {
                  "type": "heading",
                  "content": {
                    "text": "Office hours",
                    "level": "3"
                  }
                },
                {
                  "type": "rich-text",
                  "content": {
                    "html": "<p>Sunday to Thursday, 9:00 to 17:00.</p><p>Visits by appointment.</p>"
                  }
                },
                {
                  "type": "button-group",
                  "children": [
                    {
                      "type": "button",
                      "content": {
                        "label": "Send us an e-mail",
                        "link": {
                          "type": "url",
                          "url": "mailto:info@example.org"
                        },
                        "variant": "primary"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "style": {
        "background": {
          "type": "color",
          "color": {
