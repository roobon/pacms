{
  "schema_version": "1.0",
  "kind": "template",
  "meta": {
    "generator": "PACMS starter kit",
    "title": "Contact details"
  },
  "template": {
    "name": "Contact details",
    "slug": "kit-contact-details",
    "scope": "section",
    "category": "Content",
    "description": "E-mail, phone, address and office hours."
  },
  "blocks": [
    {
      "type": "section",
      "layout": {
        "container": "boxed",
        "padding": {
          "top": {
            "$token": "space.section"
          },
          "bottom": {
            "$token": "space.section"
          }
        }
      },
      "children": [
        {
          "type": "columns",
          "layout": {
            "columns": {
              "desktop": [
                6,
                6
              ],
              "mobile": [
                12,
                12
              ]
            },
            "gap": {
              "$token": "space.6"
            }
          },
          "children": [
            {
              "type": "column",
              "children": [
                {
                  "type": "heading",
                  "content": {
                    "text": "Get in touch",
                    "level": "2"
                  }
                },
                {
                  "type": "rich-text",
                  "content": {
                    "html": "<p>Tell visitors when and how to reach you, and how quickly you reply.</p>"
