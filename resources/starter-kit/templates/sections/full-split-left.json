{
  "schema_version": "1.0",
  "kind": "template",
  "meta": {
    "generator": "PACMS starter kit",
    "title": "Full width: photo left, text right"
  },
  "template": {
    "name": "Full width: photo left, text right",
    "slug": "kit-full-split-left",
    "scope": "section",
    "category": "Full width",
    "description": "A photo filling the left half of the screen to its edge, with a heading, text and a button beside it."
  },
  "blocks": [
    {
      "type": "split",
      "content": {
        "image_side": "left",
        "image_width": "half",
        "height": "md"
      },
      "children": [
        {
          "type": "heading",
          "content": {
            "text": "A heading about this part of your work",
            "level": "2",
            "eyebrow": "Our work"
          }
        },
        {
          "type": "rich-text",
          "content": {
            "html": "<p>Two or three sentences about this part of your work. Replace the photo with one of your own under Content → Photo.</p>"
          }
        },
        {
          "type": "button-group",
          "children": [
            {
              "type": "button",
              "content": {
                "label": "Read more",
                "link": {
                  "type": "url",
                  "url": "/about"
                },
                "variant": "primary"
              }
            }
          ]
        }
      ]
    }
  ]
}
