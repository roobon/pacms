{
  "schema_version": "1.0",
  "kind": "template",
  "meta": {
    "generator": "PACMS starter kit",
    "title": "About us: Impact"
  },
  "template": {
    "name": "About us: Impact",
    "slug": "kit-page-about-impact",
    "scope": "page",
    "category": "About pages",
    "description": "Impact report: results first, then what you do, where the money goes, reports to download and partners."
  },
  "blocks": [
    {
      "type": "section",
      "layout": {
        "container": "boxed",
        "padding": {
          "top": {
            "$token": "space.9"
          },
          "bottom": {
            "$token": "space.9"
          }
        },
        "text_align": "center"
      },
      "children": [
        {
          "type": "heading",
          "content": {
            "text": "Our impact in numbers",
            "level": "1",
            "eyebrow": "About us"
          }
        },
        {
          "type": "rich-text",
          "content": {
            "html": "<p>A sentence about the change you made this year.</p>"
          }
        },
        {
          "type": "statistics",
          "content": {
            "heading": "",
            "items": [
              {
                "value": 25,
                "label": "Years of work",
                "icon": "bi-calendar-check"
              },
              {
                "value": 120,
                "label": "Partner schools",
                "icon": "bi-building"
              },
              {
                "value": 5000,
                "suffix": "+",
                "label": "People reached",
                "icon": "bi-people"
              },
              {
                "value": 12,
                "label": "Districts",
                "icon": "bi-geo-alt"
              }
            ]
          },
          "display": {
            "mode": "grid"
          }
        }
      ],
      "content": {
        "aria_label": "Introduction"
      },
      "style": {
        "background": {
          "type": "gradient",
          "gradient": {
            "angle": 135,
            "stops": [
              {
                "color": {
                  "$token": "color.primary"
                },
                "at": 0
              },
              {
                "color": {
                  "$token": "color.secondary"
                },
                "at": 100
              }
            ]
          }
        }
      }
    },
    {
      "type": "section",
      "layout": {
        "container": "boxed",
        "padding": {
          "top": {
            "$token": "space.section"
          },
          "bottom": {
            "$token": "space.section"
          }
        }
      },
      "children": [
        {
          "type": "columns",
          "layout": {
            "columns": {
              "desktop": [
                6,
                6
              ],
              "mobile": [
                12,
                12
              ]
            },
            "gap": {
              "$token": "space.6"
            },
            "align": "center"
          },
          "children": [
            {
              "type": "column",
              "children": [
                {
                  "type": "heading",
                  "content": {
                    "text": "What we do",
                    "level": "2"
                  }
                },
                {
                  "type": "rich-text",
                  "content": {
                    "html": "<p>Describe your main programmes and who benefits, in two or three sentences.</p>"
                  }
                },
                {
                  "type": "button-group",
                  "children": [
                    {
                      "type": "button",
                      "content": {
                        "label": "Our programmes",
                        "link": {
                          "type": "url",
                          "url": "/programs"
                        },
                        "variant": "primary"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "type": "column",
              "children": [
                {
                  "type": "cards",
                  "content": {
                    "heading": "",
                    "items": [
                      {
                        "icon": "bi-mortarboard",
                        "title": "Education",
                        "text": "Schools and teachers reached."
                      },
                      {
                        "icon": "bi-people",
                        "title": "Community",
                        "text": "Families and groups supported."
                      }
                    ]
                  },
                  "display": {
                    "mode": "grid",
                    "columns": {
                      "desktop": 2,
                      "tablet": 2,
                      "mobile": 1
                    }
                  }
                }
              ]
            }
          ]
        }
      ],
      "content": {
        "aria_label": "What we do"
      }
    },
    {
      "type": "section",
      "layout": {
        "container": "boxed",
        "padding": {
          "top": {
            "$token": "space.section"
          },
          "bottom": {
            "$token": "space.section"
          }
        },
        "text_align": "center"
      },
      "children": [
        {
          "type": "heading",
          "content": {
            "text": "Where the money goes",
            "level": "2"
          }
        },
        {
          "type": "cards",
          "content": {
            "heading": "",
            "items": [
              {
                "icon": "bi-pie-chart",
                "title": "80% Programmes",
                "text": "Spent directly on the work in communities."
              },
              {
                "icon": "bi-briefcase",
                "title": "15% Running costs",
                "text": "Staff, offices and systems."
              },
              {
                "icon": "bi-megaphone",
                "title": "5% Fundraising",
                "text": "Raising the next year’s support."
              }
            ]
          },
          "display": {
            "mode": "grid",
            "columns": {
              "desktop": 3,
              "tablet": 2,
              "mobile": 1
            }
          }
        }
      ],
      "content": {
        "aria_label": "Finances"
      },
      "style": {
        "background": {
          "type": "color",
          "color": {
            "$token": "color.bg-light"
          }
        }
      }
    },
    {
      "type": "section",
      "layout": {
        "container": "boxed",
        "padding": {
          "top": {
            "$token": "space.section"
          },
          "bottom": {
            "$token": "space.section"
          }
        }
      },
      "children": [
        {
          "type": "publications",
          "content": {
            "heading": "Reports"
          },
          "source": {
            "mode": "dynamic",
            "entity": "publications",
            "order": "latest",
            "limit": 3
          },
          "display": {
            "mode": "grid",
            "columns": {
              "desktop": 3,
              "tablet": 2,
              "mobile": 1
            },
            "card_style": "elevated",
            "image_ratio": "4:3"
          }
        }
      ],
      "content": {
        "aria_label": "Reports"
      }
    },
    {
      "type": "section",
      "layout": {
        "container": "boxed",
        "padding": {
          "top": {
            "$token": "space.section"
          },
          "bottom": {
            "$token": "space.section"
          }
        }
      },
      "children": [
        {
          "type": "testimonials",
          "content": {
            "heading": "Stories of change",
            "show_photo": true,
            "show_rating": false
          },
          "source": {
            "mode": "dynamic",
            "entity": "testimonials",
            "order": "position",
            "limit": 6
          },
          "display": {
            "mode": "carousel",
            "columns": {
              "desktop": 3,
              "tablet": 2,
              "mobile": 1
            }
          }
        }
      ],
      "content": {
        "aria_label": "Stories"
      },
      "style": {
        "background": {
          "type": "color",
          "color": {
            "$token": "color.bg-light"
          }
        }
      }
    },
    {
      "type": "section",
      "layout": {
        "container": "boxed",
        "padding": {
          "top": {
            "$token": "space.section"
          },
          "bottom": {
            "$token": "space.section"
          }
        }
      },
      "children": [
        {
          "type": "partners",
          "content": {
            "heading": "Our funders and partners",
            "style": "logos",
            "grayscale": true,
            "logo_size": "md"
          },
          "source": {
            "mode": "dynamic",
            "entity": "partners",
            "order": "position",
            "limit": 12
          },
          "display": {
            "mode": "grid",
            "columns": {
              "desktop": 6,
              "tablet": 2,
              "mobile": 1
            },
            "card_style": "elevated",
            "image_ratio": "16:9"
          }
        }
      ],
      "content": {
        "aria_label": "Partners"
      }
    },
    {
      "type": "section",
      "layout": {
        "container": "boxed",
        "padding": {
          "top": {
            "$token": "space.section"
          },
          "bottom": {
            "$token": "space.section"
          }
        }
      },
      "children": [
        {
          "type": "global-ref",
          "content": {
            "global": {
              "$ref": {
                "entity": "global_blocks",
                "slug": "call-to-action"
              }
            }
          }
        }
      ],
      "content": {
        "aria_label": "Call to action"
      }
    }
  ]
}
