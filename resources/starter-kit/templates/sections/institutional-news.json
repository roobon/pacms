{
  "schema_version": "1.0",
  "kind": "template",
  "meta": {
    "generator": "PACMS starter kit",
    "title": "Institutional: news in five columns"
  },
  "template": {
    "name": "Institutional: news in five columns",
    "slug": "kit-institutional-news",
    "scope": "section",
    "category": "Institutional",
    "description": "The five newest news items under a title in capitals, with a button."
  },
  "blocks": [
    {
      "type": "section",
      "layout": {
        "container": "boxed",
        "padding": {
          "top": {
            "$token": "space.4"
          },
          "bottom": {
            "$token": "space.4"
          }
        }
      },
      "children": [
        {
          "type": "heading",
          "content": {
            "text": "Latest news",
            "level": "2"
          },
          "layout": {
            "text_align": "center",
            "margin": {
              "bottom": {
                "$token": "space.6"
              }
            }
          },
          "style": {
            "typography": {
              "color": {
                "$token": "color.primary"
              },
              "transform": "uppercase",
              "align": "center",
              "letter_spacing": "wide"
            }
          }
        },
        {
          "type": "news",
          "content": {
            "heading": "",
            "show_excerpt": false,
            "show_date": true
          },
          "source": {
            "mode": "dynamic",
            "entity": "news",
            "order": "latest",
            "limit": 5
          },
          "display": {
            "mode": "grid",
            "columns": {
              "desktop": 5,
              "tablet": 3,
              "mobile": 1
            },
            "card_style": "flat",
            "image_ratio": "1:1"
          }
        },
        {
          "type": "button-group",
          "children": [
            {
              "type": "button",
              "content": {
                "label": "Read more news",
                "link": {
                  "type": "url",
                  "url": "/news"
                },
                "variant": "primary"
              },
              "style": {
                "typography": {
                  "transform": "uppercase",
                  "weight": 700,
                  "letter_spacing": "wider"
                }
              }
            }
          ],
          "layout": {
            "margin": {
              "top": {
                "$token": "space.5"
              }
            },
            "justify": "center"
          }
        },
        {
          "type": "divider",
          "content": {
            "line": "solid"
          },
          "layout": {
            "margin": {
              "top": {
                "$token": "space.8"
              },
              "bottom": {
                "$token": "space.8"
              }
            }
          }
        }
      ],
      "content": {
        "aria_label": "News"
      }
    }
  ]
}
